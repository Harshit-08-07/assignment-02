# EARTHLY E-COMMERCE CONFIGURATION & CREDENTIALS
# Copy this file to .env.local to configure live Supabase services.
# When omitted, EARTHLY runs seamlessly using its persistent local demonstration data layer.

# Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Payment Gateway Credentials (e.g. Razorpay / Stripe for India)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
